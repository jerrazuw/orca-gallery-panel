{
  "name": "orca-gallery-panel",
  "version": "1.5.0",
  "description": "Background images for the Orca agent IDE: a side panel with a rotating gallery of your own pictures.",
  "keywords": [
    "orca",
    "orca-plugin",
    "orca-ide",
    "agent-ide",
    "wallpaper",
    "background-image",
    "image-gallery",
    "slideshow",
    "side-panel"
  ],
  "license": "MIT",
  "author": {
    "name": "Jaime Errázuriz Werth",
    "url": "https://github.com/jerrazuw"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerrazuw/orca-gallery-panel.git"
  },
  "homepage": "https://github.com/jerrazuw/orca-gallery-panel#readme",
  "bugs": {
    "url": "https://github.com/jerrazuw/orca-gallery-panel/issues"
  },
  "type": "module",
  "bin": {
    "orca-gallery-panel": "lib/cli.js"
  },
  "files": [
    "lib",
    "gallery.config.schema.json",
    "gallery.config.example.json"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node src/cli.ts",
    "preview": "node src/preview.ts",
    "examples:generate": "node scripts/generate-examples.ts",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test:e2e": "node --test --test-concurrency=1 \"test/e2e/**/*.test.ts\"",
    "build:lib": "node scripts/build-lib.ts",
    "build:demo": "node scripts/build-demo-plugin.ts",
    "prepack": "npm run build:lib",
    "version": "npm run build:demo && git add plugin"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
